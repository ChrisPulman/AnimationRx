<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>AnimationRx.Avalonia.Reactive</Title>
    <RootNamespace>CP.AnimationRx.Reactive</RootNamespace>
    <DefineConstants>$(DefineConstants);REACTIVE_SHIM</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\AnimationRx.Avalonia\*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="..\AnimationRx.Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ReactiveUI.Primitives.Reactive" />
    <PackageReference Include="ReactiveUI.Primitives.Avalonia.Reactive" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="ReactiveUI.Primitives.Reactive" />
    <Using Include="ReactiveUI.Primitives.Reactive.Signals.Signal" Alias="Observable" />
    <Using Include="System.Reactive.Concurrency.IScheduler" Alias="IScheduler" />
    <Using Include="System.Reactive.Concurrency.TaskPoolScheduler" Alias="TaskPoolScheduler" />
    <Using Include="System.Reactive.Disposables.CompositeDisposable" Alias="CompositeDisposable" />
    <Using Include="System.Reactive.Disposables.Disposable" Alias="Disposable" />
    <Using Include="System.Reactive.Unit" Alias="Unit" />
  </ItemGroup>

</Project>
